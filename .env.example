DOCUMENT_PATH=/data/documents
ENVIRONMENT=development
# DISABLED by default; MOCK only for local UI acceptance, REMOTE needs a provider.
CLASSIFICATION_PROVIDER=DISABLED
REVIEW_PROVIDER=DISABLED
MAX_DOCUMENT_BYTES=26214400
MODEL_API_URL=
MODEL_HEALTH_URL=
MODEL_API_KEY=
MODEL_NAME=deepseek/deepseek-v4.1-flash
# One Novita key serves both OCR and Flash. Keep this file secret when filled.
NOVITA_API_KEY=
# Optional separate endpoint/credential overrides.
OCR_API_URL=
OCR_HEALTH_URL=
OCR_API_KEY=
OCR_MODEL=deepseek/deepseek-ocr-2
# Required only for /v1/analyze-inline (standalone/reusable API).
AGENT_API_KEY=
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_REQUEST_TIMEOUT_SECONDS=180
